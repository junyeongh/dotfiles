export PATH="$HOME/.local/bin:$PATH"
# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
*":$PNPM_HOME/bin:"*) ;;
*) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# Builtin command Aliases
alias mkdir='mkdir -pv'

function cd_ls() {
  builtin cd "$@" && ls -al
}
alias cd='cd_ls'

# Git aliases

alias gaa='git add .'
alias gaaa='git add --all'
alias gau='git add --update'
alias gb='git branch'
alias gbd='git branch --delete'
alias gc='git commit'
alias gcf='git commit --fixup'
alias gcm='git commit --message'
alias gd='git diff'
alias gda='git diff HEAD'
alias gi='git init'
alias gld='git log --pretty=format:"%h %ad %s" --date=short --all'
alias glg='git log --graph --oneline --decorate --all'
alias gm='git merge --no-ff'
alias gma='git merge --abort'
alias gmc='git merge --continue'
alias gp='git pull'
alias gpr='git pull --rebase'
alias gr='git rebase'
alias gs='git status'
alias gss='git status --short'
alias gst='git stash'
alias gstl='git stash list'
alias gsts='git stash --staged'
alias gwa='git worktree add'
alias gwr='git worktree remove'
alias gwl='git worktree list'

# https://piechowski.io/post/git-commands-before-reading-code/
# git frequently changed files
alias gfcf='git log --format=format: --name-only --since="1 year ago" | sort | uniq -c | sort -nr | head -20'
# git contributor ranking
alias gcr='git shortlog -sn --no-merges'
# git monthly commits count
alias gmcc='git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c'

# git uses `hx` (core.editor), except in VS Code's integrated terminal
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
  export GIT_EDITOR="code --wait"
fi

# herdr aliases
alias hr='herdr'
alias hrs='herdr session'
alias hrsl='herdr session list'
alias hrsa='herdr session attach'
alias hrss='herdr session stop'
alias hrsd='herdr session delete'

alias cargo-upgrade="cargo install $(cargo install --list | awk '/:$/ { print $1; }')"
alias claudex='claude --dangerously-skip-permissions'
alias ls='eza -all --icons --git --header --group-directories-first --sort=type'
alias tree='eza -all --tree'
alias ff='fastfetch'
alias fzfp='fzf --preview "bat --color=always --style=header,grid --line-range :500 {}"'
alias ld='lazydocker'
alias lg='lazygit'

# Update
alias pnpm-up='pnpm update --global --latest'
alias mise-up='mise upgrade && mise prune --yes'

# nix related
alias nix-optimise="sudo nix-store --optimise"
alias hm="home-manager --flake ~/dotfiles#wsl"
alias hm-up="home-manager --flake ~/dotfiles#wsl switch"
