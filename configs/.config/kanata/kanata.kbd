(defcfg
  linux-dev /dev/input/event0 ;; This one
  concurrent-tap-hold yes
)

(defsrc
  caps lsft rsft
)

(defalias
  ;; tap-hold-press <tap-timeout> <hold-timeout> <tap-action> <hold-action>
  escctrl (tap-hold-press 50 80 esc lctl)
)

(deflayer base
  @escctrl lsft rsft
)

(defchordsv2
  (lsft rsft) caps 200 all-released ()
)
