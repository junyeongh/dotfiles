{
  "active_pane_modifiers": {},
  "autosave": "on_focus_change",
  "buffer_font_family": "D2CodingLigature Nerd Font",
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "debugger": {
    "dock": "left"
  },
  "disable_ai": true,
  "document_folding_ranges": "on",
  "ensure_final_newline_on_save": false,
  "format_on_save": "off",
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "git_panel": {
    "dock": "right",
    "group_by": "none",
    "tree_view": true
  },
  "helix_mode": true,
  "icon_theme": "Material Icon Theme",
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "diagnostic_badges": true,
    "dock": "left",
    "git_status_indicator": true,
    "hide_gitignore": false
  },
  "semantic_tokens": "combined",
  "session": {
    "trust_all_worktrees": true
  },
  "show_whitespaces": "all",
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "font_size": 12,
    "line_height": "standard",
    "toolbar": {
      "breadcrumbs": true
    }
  },
  "theme": "Nord Dark",
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": true
  },
  "ui_font_family": "Pretendard",
  "ui_font_size": 16,
  "use_system_window_tabs": false,
  "vim_mode": false,
  "which_key": {
    "enabled": true
  }
}
